rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // V4/V6 • vínculo do save local com a conta Firebase/Google.
    match /player_accounts/{uid} {
      allow get, create, update: if isOwner(uid);
      allow list, delete: if false;
    }

    // V5 • visita às fábricas da comunidade.
    match /public_factories/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // V7 • mercado do personagem principal.
    match /character_offers/{ownerId} {
      allow read: if signedIn();

      allow create: if isOwner(ownerId)
                    && request.resource.data.ownerUid == ownerId;

      allow update: if signedIn() && (
        (
          request.auth.uid == ownerId
          && request.resource.data.ownerUid == ownerId
        )
        ||
        (
          request.auth.uid != ownerId
          && resource.data.ownerUid == ownerId
          && request.resource.data.ownerUid == ownerId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['leasedBy', 'leasedUntil'])
          && request.resource.data.leasedBy == request.auth.uid
          && resource.data.leasedUntil <= request.time
          && request.resource.data.leasedUntil > request.time
        )
      );

      allow delete: if isOwner(ownerId);
    }

    // Histórico das contratações por 48h.
    match /character_rentals/{rentalId} {
      allow create: if signedIn()
                    && request.resource.data.renterUid == request.auth.uid
                    && request.resource.data.ownerUid != request.auth.uid;

      allow read: if signedIn() && (
        resource.data.renterUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );

      allow update, delete: if false;
    }

    // Regras legadas preservadas automaticamente pela V9.
    match /players/{uid} {
    allow read: if signedIn();
    allow create, update: if signedIn()
    && request.auth.uid == uid
    && request.resource.data.uid == uid
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() >= 3
    && request.resource.data.displayName.size() <= 24
    && request.resource.data.companyLevel is int
    && request.resource.data.companyLevel >= 1
    && request.resource.data.reputation is int
    && request.resource.data.reputation >= 0;
    allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /helps/{helpId} {
    // Criar apoio: somente o usuário autenticado pode ser o remetente.
    allow create: if signedIn()
    && request.resource.data.fromUid == request.auth.uid
    && request.resource.data.toUid is string
    && request.resource.data.toUid != request.auth.uid
    && request.resource.data.claimed == false
    && request.resource.data.rewardBoosts == 1;
    
    // Só remetente e destinatário podem ler um apoio já existente.
    allow read: if signedIn()
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    
    // Só o destinatário pode marcar o apoio como resgatado.
    allow update: if signedIn()
    && resource.data.toUid == request.auth.uid
    && resource.data.claimed == false
    && request.resource.data.claimed == true
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']);
    
    allow delete: if false;
    }

    // Segurança padrão: qualquer coleção que não tenha regra explícita fica bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
